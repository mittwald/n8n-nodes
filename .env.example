IT_MITTWALD_API_TOKEN=TO_BE_SET
IT_SERVER_ID=TO_BE_SET
IT_INVITE_TARGET=TO_BE_SET@example.com
IT_INVITE_USER_TOKEN=TO_BE_SET
IT_DNS_PARENT_ZONE_ID=
IT_CUSTOMER_ID=
IT_DOMAIN=
# A domain that tests may schedule for deletion and delete outright.
IT_EXPENDABLE_DOMAIN=
# A domain the delete test may consume. Deleting cannot be undone, so this is
# kept separate from IT_EXPENDABLE_DOMAIN and left empty by default.
IT_DELETABLE_DOMAIN=
# Mail address of an organisation member the test may remove. The membership
# cannot be restored automatically — the user has to accept a fresh invite.
IT_REMOVABLE_MEMBER_MAIL=
# Optional: target a non-production mittwald environment. Read by the node inside
# the n8n container (via docker-compose) and by the integration test client.
# Leave empty for the production API.
MITTWALD_API_BASE_URL=
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=TO_BE_SET
N8N_MITTWALD_CREDENTIAL_ID=1234
N8N_REST_LOGIN_EMAIL=ANOTHER_TO_BE_SET@example.com
N8N_REST_LOGIN_PASSWORD=TO_BE_SET
